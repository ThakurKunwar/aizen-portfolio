APP_NAME="Aizen Kunwar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite needs no setup: the file is database/database.sqlite.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------------------------
# Mail. "log" writes contact-form emails to storage/logs/laravel.log (fine locally).
# For a real server use SMTP, for example from Brevo, Resend or Gmail.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Portfolio (see config/portfolio.php for the rest of your content)
# ---------------------------------------------------------------------------
PORTFOLIO_NAME="Aizen Kunwar"
PORTFOLIO_ROLE="Back-end developer"
PORTFOLIO_EMAIL=you@example.com
PORTFOLIO_GITHUB=https://github.com/ThakurKunwar
PORTFOLIO_LINKEDIN=

# The one admin account, created by "php artisan migrate --seed".
# CHANGE THE PASSWORD before you put the site online.
ADMIN_NAME="Aizen"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# Only needed if your company hosts its own GitLab. It lets a pasted repo link
# from that address show a "GitLab" label. Nothing is ever fetched from it.
GITLAB_URL=https://gitlab.com
